# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha com valores reais.
# NUNCA commite o `.env` real -- ele contém segredos (chave de API e senha).
# O `.gitignore` já ignora `.env`.
# ---------------------------------------------------------------------------

# Chave da API da Anthropic (Claude). Obtenha em https://console.anthropic.com/
# Se definida, é o provider usado. Se AUSENTE, o app cai para o Amazon Bedrock
# usando suas credenciais AWS (perfil `default` do ~/.aws). Sem nenhum dos dois,
# o chat fica desabilitado com um aviso amigável.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Fallback via Amazon Bedrock (opcional) ---------------------------------
# Só é usado quando ANTHROPIC_API_KEY está ausente. As credenciais vêm da cadeia
# padrão do AWS (perfil `default` do ~/.aws), então normalmente NÃO precisa
# declarar nada aqui. Descomente para sobrescrever o perfil/região/modelo:
# AWS_PROFILE=default
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0


# --- Credenciais que o vetflow-mcp usa para falar com o backend VetFlow ------
# Estas variáveis são repassadas ao subprocesso MCP; o app NÃO fala com o
# backend Go diretamente.

# URL raiz da API do backend VetFlow (Go).
VETFLOW_BASE_URL=http://localhost:8080

# Login de um usuário vet (usado no POST /auth/login do backend).
VETFLOW_EMAIL=seu-email@exemplo.com
VETFLOW_PASSWORD=sua-senha

# Timeout por requisição HTTP ao backend, em segundos (opcional).
VETFLOW_TIMEOUT_S=15

# Habilita as ferramentas de ESCRITA do MCP (criar/atualizar). Default: desligado.
# Deixe `false` para uma superfície somente-leitura (recomendado).
VETFLOW_ENABLE_WRITES=false
